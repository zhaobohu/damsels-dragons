#nexus
begin sets;
  charset p1 = align/COI.trim.fasta: 1-658\3;
  charset p2 = align/COI.trim.fasta: 2-658\3;
  charset p3 = align/COI.trim.fasta: 3-658\3;
  charset p4 = align/EF1a.trim.fasta: 1-783\3;
  charset p5 = align/EF1a.trim.fasta: 2-783\3;
  charset p6 = align/EF1a.trim.fasta: 3-783\3;
  charpartition mymodels =
    GTR+F+ASC+R8: p1,
    GTR+F+I+R5: p2,
    TIM3+F+R3: p3,
    TIM2+I+G4: p4,
    TPM3u+F+R4: p5,
    TVM+F+G4: p6;
end;
